# ---------------------------------------------------------------------------
# 复制成 .env 后填入真实值。.env 已被 .gitignore 排除，永远不会进仓库。
# 代码里不读取任何硬编码密钥，所有配置都从这里来（见 src/agent_rag/config.py）。
# ---------------------------------------------------------------------------

# --- LLM ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- 天气工具（可选，留空则该工具返回“未配置”）---
QWEATHER_API_KEY=
QWEATHER_HOST=

# --- 向量化 ---
EMBED_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录，建议放在项目外的大盘，例如 E:/models/hf
HF_HOME=

# --- 检索参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
USE_BM25=true

# --- Agent ---
MAX_AGENT_STEPS=8
SQLITE_PATH=var/agent.sqlite

# --- 服务 ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
